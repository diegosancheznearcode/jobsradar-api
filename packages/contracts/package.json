  "description": "Esquemas Zod compartidos entre jobsradar-api y jobsradar-web. Ver ARCHITECTURE.md sección 4.1.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "repository": {
    "type": "git",
