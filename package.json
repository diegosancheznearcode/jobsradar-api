{
  "name": "jobsradar-api",
  "private": true,
  "version": "0.1.0",
  "description": "JobsRadar backend (API + worker + domain + contracts). See docs/ARCHITECTURE.md.",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "dev:api": "pnpm --filter @jobsradar/api dev",
    "dev:worker": "pnpm --filter @jobsradar/worker dev"
  }
}
